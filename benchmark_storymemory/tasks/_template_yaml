# StoryMemory task template for lm-evaluation-harness.
# Each item: a short story ending in an unfinished sentence; pick the choice word that
# completes it. Scored like HellaSwag: log P(" " + choice | context), highest wins.
dataset_path: json
test_split: test
output_type: multiple_choice
doc_to_text: "{{context}}"
doc_to_choice: "{{choices}}"
doc_to_target: "{{gold}}"
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
